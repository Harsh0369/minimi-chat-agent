{
  "name": "minimi-chat-agent",
  "version": "0.1.0",
  "private": true,
  "overrides": {
    "minimatch@^10": "11.0.5"
  },
  "type": "module",
  "engines": {
    "node": ">=24.14.1 <25"
  },
  "scripts": {
    "dev": "tsx --env-file-if-exists=.env src/server/main.ts",
    "build": "npm run typecheck && vite build && tsc -p tsconfig.server.json",
    "start": "node --env-file-if-exists=.env dist/server/main.js --production",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src tests *.config.ts eslint.config.js",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm test"
  },
  "dependencies": {
    "@langchain/core": "1.4.0",
    "@langchain/groq": "1.3.1",
    "@langchain/langgraph": "1.7.3",
    "@langchain/openai": "1.8.4",
    "better-sqlite3": "13.0.3",
    "express": "5.3.0",
    "helmet": "8.3.0",
    "lucide-react": "1.71.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.65.0",
    "@tailwindcss/vite": "4.3.5",
    "@types/better-sqlite3": "9.6.0",
    "@types/express": "5.0.6",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "eslint": "10.14.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.14.0",
    "prettier": "3.9.10",
    "tailwindcss": "4.3.5",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.2",
    "vite": "8.3.7",
    "vitest": "5.1.0"
  }
}
