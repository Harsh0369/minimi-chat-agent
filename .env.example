# Module 1 runs without provider keys. Live chat in a later module requires both.
# Keep keys server-side; never create VITE_OPENAI_API_KEY or VITE_TAVILY_API_KEY.
OPENAI_API_KEY=
TAVILY_API_KEY=

# Set an accessible chat model ID before live agent evaluation.
CHAT_MODEL=
EMBEDDING_MODEL=text-embedding-3-small

# Loopback only. Use 127.0.0.1 or ::1. Module 2 creates this SQLite database on startup.
HOST=127.0.0.1
PORT=3000
DATABASE_PATH=./data/minimi.sqlite
