# Choose one model provider; Gemini remains the default. Keep keys server-side.
# Never use VITE_ variables for secrets. Tavily is the sole web-search tool.
MODEL_PROVIDER=gemini
GEMINI_API_KEY=
# For MODEL_PROVIDER=openai, set OPENAI_API_KEY and CHAT_MODEL explicitly.
# OPENAI_API_KEY=
# For MODEL_PROVIDER=groq, set GROQ_API_KEY. Default model: openai/gpt-oss-120b.
# GROQ_API_KEY=
TAVILY_API_KEY=

# Optional for Gemini/Groq; required for OpenAI. Check model access and quotas.
CHAT_MODEL=

# Optional semantic recall. Uses the Gemini key even if the chat provider is
# OpenAI or Groq. Without a Gemini key, exact-date and lexical recall remain.
# EMBEDDING_MODEL=gemini-embedding-001

# Loopback only. Use 127.0.0.1 or ::1.
HOST=127.0.0.1
PORT=3000
DATABASE_PATH=./data/minimi.sqlite
# Optional duration-only logs for local latency checks; no prompts or keys.
# PERF_LOG=1
