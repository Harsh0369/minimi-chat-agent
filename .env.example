# Chat requires both keys. Keep keys server-side; never use VITE_ variables for secrets.
GEMINI_API_KEY=
TAVILY_API_KEY=

# Optional. See Google's model list and your account limits.
CHAT_MODEL=gemini-2.5-flash

# Loopback only. Use 127.0.0.1 or ::1.
HOST=127.0.0.1
PORT=3000
DATABASE_PATH=./data/minimi.sqlite
