# Chat requires both keys. Keep keys server-side; never use VITE_ variables for secrets.
GEMINI_API_KEY=
TAVILY_API_KEY=

# Optional. See Google's model list and your account limits.
CHAT_MODEL=gemini-3.5-flash-lite

# Optional semantic recall over the latest 80 messages; falls back to lexical retrieval.
# Uses the Gemini key and additional embedding quota. Leave unset to disable.
# EMBEDDING_MODEL=gemini-embedding-001

# Loopback only. Use 127.0.0.1 or ::1.
HOST=127.0.0.1
PORT=3000
DATABASE_PATH=./data/minimi.sqlite
